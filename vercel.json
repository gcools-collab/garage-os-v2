{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "leboncoin-bridge",
          "format": "url",
          "env": "LEBONCOIN_BRIDGE_URL"
        }
      ]
    },
    "leboncoin-bridge": {
      "root": "services/leboncoin-bridge",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/leboncoin-bridge/:path*",
      "destination": {
        "service": "leboncoin-bridge"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
