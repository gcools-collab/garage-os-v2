NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://garage.example.com
PAYPLUG_ENABLED=false
PAYPLUG_MODE=test
PAYPLUG_TEST_KEY=
# PAYPLUG_LIVE_KEY is intentionally not consumed while TEST acceptance is active.
PAYPLUG_API_URL=https://api.payplug.com
PAYPLUG_API_VERSION=2019-08-06
# Bridge interne Leboncoin (analyse marché sur /stock/[id], rachats/acquisition, présence en ligne).
# Sans ces deux variables, l'app répond "Le service d'analyse du marché n'est pas configuré."
# Si elles sont renseignées mais que rien n'écoute à cette adresse, elle répond "fetch failed" —
# démarrez le bridge localement (voir services/leboncoin-bridge/README.md) avant de les définir.
LEBONCOIN_BRIDGE_URL=http://127.0.0.1:8080
LEBONCOIN_BRIDGE_API_KEY=
